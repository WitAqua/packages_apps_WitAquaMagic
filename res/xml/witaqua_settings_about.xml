<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/about_title">

    <!-- WitAqua logo -->
    <com.android.settingslib.widget.LayoutPreference
        android:key="logo_witaqua"
        android:layout="@layout/logo_witaqua_layout"
        android:clickable="false"/>

    <!-- Info -->
    <com.android.settingslib.widget.TopIntroPreference
        android:title="@string/about_info" />

    <!-- Website -->
    <Preference
        android:title="@string/about_website_title"
        android:icon="@drawable/ic_about"
        android:summary="@string/about_website_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/about_website_url" />
    </Preference>

    <!-- Discord -->
    <Preference
        android:title="@string/about_discord_title"
        android:icon="@drawable/ic_discord"
        android:summary="@string/about_discord_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/about_discord_url" />
    </Preference>

    <!-- X (Twitter) -->
    <Preference
        android:title="@string/about_x_title"
        android:icon="@drawable/ic_x"
        android:summary="@string/about_x_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/about_x_url" />
    </Preference>

    <!-- Github -->
    <Preference
        android:title="@string/about_github_title"
        android:icon="@drawable/ic_github"
        android:summary="@string/about_github_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/about_github_url" />
    </Preference>

    <PreferenceCategory
        android:key="contributors"
        android:title="@string/about_contributors_title" />

    <!-- Contributor 1 -->
    <Preference
        android:title="@string/about_contributor_1_title"
        android:summary="@string/about_contributor_1_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/about_contributor_1_url" />
    </Preference>

    <!-- Contributor 2 -->
    <Preference
        android:title="@string/about_contributor_2_title"
        android:summary="@string/about_contributor_2_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/about_contributor_2_url" />
    </Preference>

    <!-- Contributor 3 -->
    <Preference
        android:title="@string/about_contributor_3_title"
        android:summary="@string/about_contributor_3_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/about_contributor_3_url" />
    </Preference>

</PreferenceScreen>
